import asyncio
from datetime import datetime
import discord
from discord.ext import tasks

TOKEN = ""

CANALE_ID = 123456789012345678

intents = discord.Intents.default()
intents.message_content = True
client = discord.Client(intents=intents)

@client.event
async def on_ready():
  print(f"Bot connesso come {client.user}!")

  controlla_tempo.start()

  canale = client.get_channel(CANALE_ID)
  if canale:
    await canale.send(
        "🌿 **Buona azione!**: oggi pianta qualcosa (Example) 🌱"
    )

@tasks.loop(hours=1, count=1)  
async def controlla_tempo():
  canale = client.get_channel(CANALE_ID)
  if canale:
    await canale.send(
        "⚠️ **Ehi, spegni il pc!** Stai consumando energia e stai"
        " praticamente frustando il pianeta, spegni! 🌍🔌"
    )

@controlla_tempo.before_loop
async def prima_di_partire():
  await client.wait_until_ready()

client.run(TOKEN)
